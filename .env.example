# anesthesia-patient-simulation — ISOLATED configuration.
# Copy to .env and fill in. This file is NEVER shared with the mock-oral
# project; variable names are namespaced PSIM_* so a stale shell export from
# the mock-oral system can never leak into a patient-simulation run.

# --- LLM (the patient) ---
ANTHROPIC_API_KEY=

# --- Speech-to-text (clinician audio -> text) ---
GROQ_API_KEY=

# --- Text-to-speech (patient utterance -> audio) ---
ELEVENLABS_API_KEY=

# --- LiveKit (room modes: dev / start / connect; not needed for console) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Patient-simulation options (all PSIM_-namespaced) ---
# PSIM_SCENARIO=case_001
# PSIM_MODEL=claude-opus-4-8
# PSIM_PORT=8091
# PSIM_STREAM_TTS=1
# PSIM_LOG_DIR=logs
# Scenario-level voice; scenarios/<id>/voice.json overrides this.
# PSIM_VOICE_ID=
